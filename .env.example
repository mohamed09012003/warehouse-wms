# Copy to .env and fill in real values. .env is git-ignored. NEVER commit real credentials.

# Development database (must be named warehouse_wms).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/warehouse_wms"

# Automated-test database (must be named warehouse_wms_test). Tests refuse to run otherwise.
# Create this database yourself; the test suite only applies migrations to it.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/warehouse_wms_test"

# Auth.js signing secret, at least 32 characters. Generate one with:  npx auth secret
# or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: password for the seeded demo user (otherwise a random one is printed once).
# SEED_DEMO_PASSWORD=""
