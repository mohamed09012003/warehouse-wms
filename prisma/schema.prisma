// Phase 1 schema: tenancy + identity only. See docs/database.md.
//
// Tenant isolation pattern: every tenant-owned parent has @@unique([organizationId, id]);
// children reference it with a COMPOSITE foreign key (organizationId, parentId), so a row
// can never point at another organization's parent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  roles               Role[]
  memberships         Membership[]
  palletTypes         PalletType[]
  warehouses          Warehouse[]
  products            Product[]
  inventoryOperations InventoryOperation[]
  reservations        Reservation[]
  orders              Order[]
  pickingWaves        PickingWave[]
  packingSessions     PackingSession[]
  idempotencyRecords  IdempotencyRecord[]
  integrations        Integration[]
  outboxEvents        OutboxEvent[]
}

// Users are GLOBAL identities (not tenant-owned). Access to an organization is via Membership.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique // stored lowercase; enforced by CHECK in the migration
  name         String
  passwordHash String
  disabledAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  memberships              Membership[]
  inventoryOperations      InventoryOperation[]
  reservations             Reservation[]
  orders                   Order[]
  pickingWaves             PickingWave[]
  packingSessionsStarted   PackingSession[]     @relation("PackingSessionStartedBy")
  packingSessionsCompleted PackingSession[]     @relation("PackingSessionCompletedBy")
  packagesCompleted        Package[]            @relation("PackageCompletedBy")
  packingEvents            PackingEvent[]       @relation("PackingEventActor")
  integrationServiceUsers  Integration[]        @relation("IntegrationServiceUser")
}

// Roles are per-organization. Permission NAMES are defined in code
// (src/modules/tenancy/domain/permissions.ts); role -> permission assignment is data.
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  Membership[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Composite FK: the role must belong to the same organization as the membership.
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([organizationId, roleId])
}

// ---------------------------------------------------------------------------
// Warehouse structure (Phase 2). See docs/warehouse-model.md.
// All lengths are integer millimetres, weights integer grams.
// Floor-plan x/y is the CENTER of an item; rotation is clockwise degrees about the center.
// ---------------------------------------------------------------------------

enum WarehouseObjectType {
  WALL
  DOOR
  AISLE
  LOADING_AREA
  PACKING_AREA
  WORK_AREA
}

// Organization-defined pallet types. Never hard-coded.
model PalletType {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  widthMm        Int
  lengthMm       Int
  heightMm       Int?
  maxLoadG       Int?
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bays         Bay[]
  positions    Position[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Warehouse {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  widthMm        Int
  lengthMm       Int
  // Optimistic concurrency for "save layout".
  layoutVersion  Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objects      WarehouseObject[]
  racks        Rack[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

// Non-storage floor-plan item: wall, door, aisle, loading/packing/work area.
model WarehouseObject {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @db.Uuid
  warehouseId    String              @db.Uuid
  type           WarehouseObjectType
  label          String?
  xMm            Int
  yMm            Int
  widthMm        Int
  depthMm        Int
  rotationDeg    Int                 @default(0)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Cascade)

  @@index([warehouseId])
}

model Rack {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  warehouseId    String   @db.Uuid
  code           String
  name           String?
  xMm            Int
  yMm            Int
  rotationDeg    Int      @default(0)
  lengthMm       Int
  depthMm        Int
  heightMm       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  warehouse Warehouse   @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  levels    RackLevel[]
  bays      Bay[]
  positions Position[]

  @@unique([organizationId, id])
  @@unique([organizationId, warehouseId, id])
  @@unique([warehouseId, code])
}

// A tier. levelIndex is stored 0-based (0 = ground); displayed 1-based (L01).
model RackLevel {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  rackId         String @db.Uuid
  levelIndex     Int
  // Height of the load beam above the floor, and usable vertical space for goods.
  elevationMm    Int
  clearanceMm    Int
  maxLoadG       Int?

  rack      Rack       @relation(fields: [organizationId, rackId], references: [organizationId, id], onDelete: Cascade)
  positions Position[]

  @@unique([rackId, levelIndex])
  @@unique([organizationId, rackId, id])
}

// A section along the rack's length, shared by all levels. bayIndex is 1-based.
// Bay depth = rack depth; bay height = the level's clearance (derived, not stored).
model Bay {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  rackId         String  @db.Uuid
  bayIndex       Int
  offsetMm       Int
  widthMm        Int
  // Storage configuration applied to every level of this bay.
  positionCount  Int     @default(1)
  palletTypeId   String? @db.Uuid

  rack       Rack        @relation(fields: [organizationId, rackId], references: [organizationId, id], onDelete: Cascade)
  palletType PalletType? @relation(fields: [organizationId, palletTypeId], references: [organizationId, id], onDelete: Restrict)
  positions  Position[]

  @@unique([rackId, bayIndex])
  @@unique([organizationId, rackId, id])
}

// The smallest addressable storage location. Structured identifiers are the truth
// (rack -> level -> bay -> positionIndex); `code` is generated from them and stored for lookup.
model Position {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  warehouseId    String  @db.Uuid
  rackId         String  @db.Uuid
  levelId        String  @db.Uuid
  bayId          String  @db.Uuid
  positionIndex  Int
  code           String
  palletTypeId   String? @db.Uuid

  rack       Rack        @relation(fields: [organizationId, warehouseId, rackId], references: [organizationId, warehouseId, id], onDelete: Cascade)
  level      RackLevel   @relation(fields: [organizationId, rackId, levelId], references: [organizationId, rackId, id], onDelete: Cascade)
  bay        Bay         @relation(fields: [organizationId, rackId, bayId], references: [organizationId, rackId, id], onDelete: Cascade)
  palletType PalletType? @relation(fields: [organizationId, palletTypeId], references: [organizationId, id], onDelete: Restrict)

  balances InventoryBalance[]

  @@unique([organizationId, warehouseId, id])
  @@unique([warehouseId, code])
  @@unique([bayId, levelId, positionIndex])
  @@unique([organizationId, id])
  @@index([rackId])
}

// ---------------------------------------------------------------------------
// Catalog and inventory (Phase 3). See docs/inventory.md.
// Quantities are integers. Balances change ONLY through guarded atomic statements in
// modules/inventory/repo; every change writes InventoryMovement rows in the same transaction.
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  RECEIVE
  MOVE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVE
  RELEASE
  // Picking: consumes reserved stock (onHand and reserved both decrease).
  PICK
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  // Every line fully consumed by picking.
  CONSUMED
}

// Product and SKU are the same entity in v1. SKU is unique per organization (stored uppercase).
model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  sku            String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  barcodes         ProductBarcode[]
  balances         InventoryBalance[]
  movements        InventoryMovement[]
  reservationLines ReservationLine[]
  orderLines       OrderLine[]
  pickTasks        PickTask[]
  packageItems     PackageItem[]
  externalRefs     ExternalRef[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

model ProductBarcode {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  barcode        String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  // A barcode resolves to at most one product per organization.
  @@unique([organizationId, barcode])
  @@index([productId])
}

// Current stock of one product at one physical Position. available = onHand - reserved (never stored).
// CHECK constraints (migration SQL): onHand >= 0, reserved >= 0, reserved <= onHand.
model InventoryBalance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  warehouseId    String   @db.Uuid
  positionId     String   @db.Uuid
  productId      String   @db.Uuid
  onHand         Int      @default(0)
  reserved       Int      @default(0)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // Composite FKs: the position must be in this organization AND this warehouse. RESTRICT, so a
  // position that has a balance row can never be silently deleted by a layout change.
  position Position @relation(fields: [organizationId, warehouseId, positionId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  product  Product  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, positionId, productId])
  @@index([organizationId, productId])
  @@index([positionId])
  @@index([organizationId, warehouseId])
}

// One business operation (receive, move, ...). Groups the movement rows it wrote and carries
// the idempotency key. Append-only (trigger in migration SQL).
model InventoryOperation {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  type           InventoryMovementType
  idempotencyKey String?
  requestHash    String?
  actorUserId    String?               @db.Uuid
  reason         String?
  refType        String?
  refId          String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]

  // NULL keys never collide, so operations without a key are unconstrained.
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
}

// Immutable audit ledger: one row per balance change. Positions are referenced by plain id plus a
// code snapshot (no FK) so history stays readable after the layout changes.
model InventoryMovement {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                @db.Uuid
  operationId             String                @db.Uuid
  type                    InventoryMovementType
  warehouseId             String                @db.Uuid
  productId               String                @db.Uuid
  positionId              String                @db.Uuid
  positionCode            String
  counterpartPositionId   String?               @db.Uuid
  counterpartPositionCode String?
  qtyDelta                Int
  reservedDelta           Int
  onHandAfter             Int
  reservedAfter           Int
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)

  operation InventoryOperation @relation(fields: [organizationId, operationId], references: [organizationId, id], onDelete: Restrict)
  product   Product            @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
  @@index([organizationId, positionId, createdAt])
  @@index([operationId])
  @@index([organizationId, createdAt])
}

model Reservation {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String            @db.Uuid
  status          ReservationStatus @default(ACTIVE)
  refType         String?
  refId           String?
  note            String?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  releasedAt      DateTime?         @db.Timestamptz(3)
  consumedAt      DateTime?         @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines        ReservationLine[]
  pickTasks    PickTask[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

// A claim on one product at one position. Position is a plain id + code snapshot (history).
model ReservationLine {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String @db.Uuid
  reservationId    String @db.Uuid
  productId        String @db.Uuid
  positionId       String @db.Uuid
  positionCode     String
  quantity         Int
  // Quantity consumed by picking. Outstanding (still reserved) = quantity - consumedQuantity.
  consumedQuantity Int    @default(0)

  reservation Reservation @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Cascade)
  product     Product     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  pickTask    PickTask?

  @@unique([organizationId, id])
  @@unique([reservationId, positionId, productId])
  @@index([organizationId, productId])
}

// ---------------------------------------------------------------------------
// Orders and picking (Phase 4). See docs/picking.md.
// Fulfilment quantities live on OrderLine (requested >= allocated >= picked, CHECKed in the
// migration). Stock itself is NEVER changed here: allocation reserves and picking consumes stock
// through the inventory module (Reservation / InventoryMovement PICK).
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  READY
  PARTIALLY_ALLOCATED
  ALLOCATED
  PICKING
  PICKED
  // A packing session is open for a fully picked order.
  PACKING
  // Every requested unit is picked AND packed (final).
  PACKED
  CANCELLED
}

enum WaveStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PickTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String      @db.Uuid
  // Normalized (uppercase) reference, unique per organization.
  orderNumber     String
  status          OrderStatus @default(DRAFT)
  // Reference in an external system, for later integrations. Not unique.
  externalRef     String?
  note            String?
  createdByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines           OrderLine[]
  tasks           PickTask[]
  packingSessions PackingSession[]
  packages        Package[]
  externalRefs    ExternalRef[]

  @@unique([organizationId, id])
  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model OrderLine {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  orderId        String @db.Uuid
  lineNo         Int
  productId      String @db.Uuid
  requestedQty   Int
  // Quantity reserved for this line and not released. Outstanding reservation = allocatedQty - pickedQty.
  allocatedQty   Int    @default(0)
  pickedQty      Int    @default(0)
  // Picked quantity placed in packages (open or completed). Invariant: packedQty <= pickedQty (CHECK).
  packedQty      Int    @default(0)

  order        Order         @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  product      Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  tasks        PickTask[]
  packageItems PackageItem[]

  @@unique([orderId, lineNo])
  // One line per product per order keeps allocation and reporting unambiguous.
  @@unique([orderId, productId])
  @@unique([organizationId, id])
  @@unique([organizationId, orderId, id, productId])
  @@index([organizationId, productId])
}

model PickingWave {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String     @db.Uuid
  // Human-readable sequence per organization (displayed as W-0001).
  number          Int
  status          WaveStatus @default(DRAFT)
  note            String?
  createdByUserId String?    @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  releasedAt      DateTime?  @db.Timestamptz(3)
  startedAt       DateTime?  @db.Timestamptz(3)
  completedAt     DateTime?  @db.Timestamptz(3)
  cancelledAt     DateTime?  @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks        PickTask[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
}

// Pick `quantity` of one product from one physical position for one order line.
// positionId is the authoritative location (plain id, no FK, like movements and reservation lines,
// so history survives layout changes); positionCode is a readable snapshot.
model PickTask {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @db.Uuid
  waveId            String?        @db.Uuid
  orderId           String         @db.Uuid
  orderLineId       String         @db.Uuid
  productId         String         @db.Uuid
  positionId        String         @db.Uuid
  positionCode      String
  // The reservation (one per task) that backs this task's stock.
  reservationId     String         @db.Uuid
  reservationLineId String         @db.Uuid
  quantity          Int
  pickedQty         Int            @default(0)
  status            PickTaskStatus @default(PENDING)
  completedAt       DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  wave            PickingWave?    @relation(fields: [organizationId, waveId], references: [organizationId, id], onDelete: Restrict)
  order           Order           @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  orderLine       OrderLine       @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)
  product         Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  reservation     Reservation     @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Restrict)
  reservationLine ReservationLine @relation(fields: [organizationId, reservationLineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  // A reservation line backs at most one task.
  @@unique([organizationId, reservationLineId])
  @@index([organizationId, status])
  @@index([organizationId, waveId])
  @@index([orderId])
  @@index([orderLineId])
  @@index([organizationId, productId])
  @@index([positionId])
}

// ---------------------------------------------------------------------------
// Packing (Phase 5). See docs/packing.md.
// Picking already CONSUMED the stock; packing only records which picked quantities went into which
// packages. Nothing here references InventoryBalance, InventoryMovement or Reservation.
// The key invariant packedQty <= pickedQty is held by OrderLine.packedQty (guarded updates + CHECK).
// ---------------------------------------------------------------------------

enum PackingSessionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PackageStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PackingEventType {
  SESSION_STARTED
  PACKAGE_CREATED
  PACKAGE_UPDATED
  ITEM_ADDED
  ITEM_CHANGED
  ITEM_REMOVED
  PACKAGE_COMPLETED
  PACKAGE_CANCELLED
  SESSION_COMPLETED
  SESSION_CANCELLED
}

// A worker packing one order. At most ONE open session per order (partial unique index in the migration).
model PackingSession {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String               @db.Uuid
  orderId           String               @db.Uuid
  status            PackingSessionStatus @default(OPEN)
  startedByUserId   String?              @db.Uuid
  completedByUserId String?              @db.Uuid
  startedAt         DateTime             @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?            @db.Timestamptz(3)
  cancelledAt       DateTime?            @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        Order          @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  startedBy    User?          @relation("PackingSessionStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  completedBy  User?          @relation("PackingSessionCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  packages     Package[]
  events       PackingEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, orderId])
  @@index([organizationId, status])
  @@index([orderId])
}

// A physical package. Numbered 1, 2, 3 ... per ORDER (cancelled packages keep their number).
// Weight in grams, dimensions in millimetres (integers).
model Package {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String        @db.Uuid
  sessionId         String        @db.Uuid
  orderId           String        @db.Uuid
  packageNumber     Int
  status            PackageStatus @default(OPEN)
  packageType       String?
  weightG           Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  completedByUserId String?       @db.Uuid
  completedAt       DateTime?     @db.Timestamptz(3)
  cancelledAt       DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  // (organizationId, sessionId, orderId): the package's order is the session's order.
  session     PackingSession @relation(fields: [organizationId, sessionId, orderId], references: [organizationId, id, orderId], onDelete: Restrict)
  order       Order          @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  completedBy User?          @relation("PackageCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  items       PackageItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, orderId])
  @@unique([orderId, packageNumber])
  @@index([organizationId, status])
  @@index([sessionId])
}

// Picked quantity of one order line placed in one package. One row per (package, order line);
// adding more of the same line increases the quantity.
model PackageItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  packageId      String   @db.Uuid
  orderId        String   @db.Uuid
  orderLineId    String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // The package and the order line must belong to the SAME order, and the product must be the line's product.
  package   Package   @relation(fields: [organizationId, packageId, orderId], references: [organizationId, id, orderId], onDelete: Restrict)
  orderLine OrderLine @relation(fields: [organizationId, orderId, orderLineId, productId], references: [organizationId, orderId, id, productId], onDelete: Restrict)
  product   Product   @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([packageId, orderLineId])
  @@index([orderLineId])
  @@index([organizationId, productId])
}

// Append-only audit trail of packing actions (trigger in the migration forbids UPDATE/DELETE).
model PackingEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  sessionId      String           @db.Uuid
  type           PackingEventType
  packageId      String?          @db.Uuid
  orderLineId    String?          @db.Uuid
  productId      String?          @db.Uuid
  quantityDelta  Int?
  quantityAfter  Int?
  detail         String?
  actorUserId    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  session PackingSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)
  actor   User?          @relation("PackingEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, sessionId, createdAt])
  @@index([packageId])
}

// Generic idempotency record: a repeated request (same scope + key + same request) is answered
// from the stored record instead of being applied twice. Used by packing now; reusable later.
model IdempotencyRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  scope          String
  key            String
  requestHash    String
  resourceType   String?
  resourceId     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, key])
}

// ---------------------------------------------------------------------------
// Integrations (Phase 6). See docs/integrations.md.
// External systems talk to the WMS through an adapter boundary. Nothing here is referenced by the
// core domain except the `OutboxEvent` table (written by core services through modules/outbox).
// Secrets live ONLY in IntegrationSecret (AES-256-GCM ciphertext); Integration.config never holds them.
// ---------------------------------------------------------------------------

enum IntegrationHealth {
  HEALTHY
  DEGRADED
  FAILING
}

enum IntegrationSecretSlot {
  CURRENT
  PREVIOUS
}

enum ExternalEntityType {
  PRODUCT
  ORDER
}

enum InboundEventStatus {
  RECEIVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
  DEAD
}

enum IntegrationDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
}

model Integration {
  id                          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String            @db.Uuid
  // Unguessable lookup key used in the public webhook URL. The only way an external caller selects an integration.
  publicId                    String            @unique
  name                        String
  // Code-defined adapter identifier, e.g. "generic-webhook".
  provider                    String
  inboundEnabled              Boolean           @default(false)
  outboundEnabled             Boolean           @default(false)
  enabled                     Boolean           @default(false)
  disabledReason              String?
  // Non-secret, provider-validated configuration (never credentials).
  config                      Json              @default("{}")
  // Permissions the integration actor may use (allowlisted in code).
  grants                      String[]
  // Dedicated non-login user: the actor recorded on everything the integration does.
  serviceUserId               String            @db.Uuid
  // Health is tracked per direction and independently: inbound outcomes never touch the outbound columns
  // (and so never affect the circuit breaker) and vice versa.
  inboundHealthStatus         IntegrationHealth @default(HEALTHY)
  inboundLastSuccessAt        DateTime?         @db.Timestamptz(3)
  inboundLastFailureAt        DateTime?         @db.Timestamptz(3)
  inboundConsecutiveFailures  Int               @default(0)
  inboundLastErrorSummary     String?
  outboundHealthStatus        IntegrationHealth @default(HEALTHY)
  outboundLastSuccessAt       DateTime?         @db.Timestamptz(3)
  outboundLastFailureAt       DateTime?         @db.Timestamptz(3)
  outboundConsecutiveFailures Int               @default(0)
  outboundLastErrorSummary    String?
  // Set by the circuit breaker (outbound failures only); outbound deliveries stay PENDING while paused.
  outboundPausedAt            DateTime?         @db.Timestamptz(3)
  archivedAt                  DateTime?         @db.Timestamptz(3)
  createdAt                   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime          @updatedAt @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceUser   User                  @relation("IntegrationServiceUser", fields: [serviceUserId], references: [id], onDelete: Restrict)
  secrets       IntegrationSecret[]
  externalRefs  ExternalRef[]
  inboundEvents InboundEvent[]
  deliveries    IntegrationDelivery[]
  logs          IntegrationLog[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, enabled])
}

model IntegrationSecret {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  integrationId  String                @db.Uuid
  name           String
  slot           IntegrationSecretSlot
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  keyId          String
  // When this value was set. A PREVIOUS value is honoured for a grace period after the CURRENT one's rotatedAt.
  rotatedAt      DateTime              @default(now()) @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([integrationId, name, slot])
  @@index([organizationId, integrationId])
}

// Maps an external identifier to a WMS entity. Typed nullable FK columns (not a polymorphic id) so the
// tenant-enforcing composite FKs still apply. Exactly one is set and it matches entityType (CHECK).
model ExternalRef {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @db.Uuid
  integrationId  String             @db.Uuid
  entityType     ExternalEntityType
  externalId     String
  productId      String?            @db.Uuid
  orderId        String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)
  product     Product?    @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  order       Order?      @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([integrationId, entityType, externalId])
  // One external identity per WMS entity per integration (NULLs never collide).
  @@unique([integrationId, productId])
  @@unique([integrationId, orderId])
  @@index([organizationId, productId])
  @@index([organizationId, orderId])
}

model InboundEvent {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String             @db.Uuid
  integrationId    String             @db.Uuid
  externalEventId  String
  eventType        String
  occurredAt       DateTime           @db.Timestamptz(3)
  // SHA-256 of the raw request body: same id + same hash = duplicate; same id + different hash = conflict.
  payloadHash      String
  // The validated envelope (size-capped by CHECK). Never copied into logs.
  payload          Json
  status           InboundEventStatus @default(RECEIVED)
  attempts         Int                @default(0)
  nextAttemptAt    DateTime           @default(now()) @db.Timestamptz(3)
  lockedUntil      DateTime?          @db.Timestamptz(3)
  resultType       String?
  resultId         String?
  lastErrorCode    String?
  lastErrorSummary String?
  correlationId    String
  receivedAt       DateTime           @default(now()) @db.Timestamptz(3)
  processedAt      DateTime?          @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, integrationId, externalEventId])
  @@index([organizationId, integrationId, status])
  @@index([organizationId, integrationId, receivedAt])
}

// Domain events written by core services in the SAME transaction as the business change.
// Provider-agnostic: the worker fans them out to integrations. `seq` is for observability only.
model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq            BigInt    @unique @default(autoincrement())
  organizationId String    @db.Uuid
  eventType      String
  schemaVersion  Int       @default(1)
  occurredAt     DateTime  @default(now()) @db.Timestamptz(3)
  payload        Json
  fannedOutAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries   IntegrationDelivery[]

  @@unique([organizationId, id])
  @@index([organizationId, eventType])
}

model IntegrationDelivery {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                    @db.Uuid
  integrationId    String                    @db.Uuid
  outboxEventId    String                    @db.Uuid
  status           IntegrationDeliveryStatus @default(PENDING)
  attempts         Int                       @default(0)
  nextAttemptAt    DateTime                  @default(now()) @db.Timestamptz(3)
  lockedUntil      DateTime?                 @db.Timestamptz(3)
  lastHttpStatus   Int?
  lastErrorCode    String?
  lastErrorSummary String?
  deliveredAt      DateTime?                 @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)
  outboxEvent OutboxEvent @relation(fields: [organizationId, outboxEventId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  // Fan-out is idempotent: one delivery per integration per event.
  @@unique([integrationId, outboxEventId])
  @@index([organizationId, integrationId, status])
  @@index([outboxEventId])
}

// Append-only operational log (trigger). Holds safe summaries only: no credentials, no headers,
// no remote response bodies, no payload copies. Event/delivery ids are plain ids (no FK) so the
// retention purge of events/deliveries never touches the log.
model IntegrationLog {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @db.Uuid
  integrationId  String               @db.Uuid
  direction      IntegrationDirection
  provider       String
  // Stable event id: the external event id (inbound) or the outbox event id (outbound).
  eventId        String?
  eventType      String?
  inboundEventId String?              @db.Uuid
  deliveryId     String?              @db.Uuid
  correlationId  String
  status         String
  attempt        Int                  @default(0)
  httpStatus     Int?
  durationMs     Int?
  safeSummary    String
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, integrationId, createdAt])
}
