// Phase 1 schema: tenancy + identity only. See docs/database.md.
//
// Tenant isolation pattern: every tenant-owned parent has @@unique([organizationId, id]);
// children reference it with a COMPOSITE foreign key (organizationId, parentId), so a row
// can never point at another organization's parent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  roles               Role[]
  memberships         Membership[]
  palletTypes         PalletType[]
  warehouses          Warehouse[]
  products            Product[]
  inventoryOperations InventoryOperation[]
  reservations        Reservation[]
  orders              Order[]
  pickingWaves        PickingWave[]
}

// Users are GLOBAL identities (not tenant-owned). Access to an organization is via Membership.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique // stored lowercase; enforced by CHECK in the migration
  name         String
  passwordHash String
  disabledAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  memberships         Membership[]
  inventoryOperations InventoryOperation[]
  reservations        Reservation[]
  orders              Order[]
  pickingWaves        PickingWave[]
}

// Roles are per-organization. Permission NAMES are defined in code
// (src/modules/tenancy/domain/permissions.ts); role -> permission assignment is data.
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  Membership[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Composite FK: the role must belong to the same organization as the membership.
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([organizationId, roleId])
}

// ---------------------------------------------------------------------------
// Warehouse structure (Phase 2). See docs/warehouse-model.md.
// All lengths are integer millimetres, weights integer grams.
// Floor-plan x/y is the CENTER of an item; rotation is clockwise degrees about the center.
// ---------------------------------------------------------------------------

enum WarehouseObjectType {
  WALL
  DOOR
  AISLE
  LOADING_AREA
  PACKING_AREA
  WORK_AREA
}

// Organization-defined pallet types. Never hard-coded.
model PalletType {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  widthMm        Int
  lengthMm       Int
  heightMm       Int?
  maxLoadG       Int?
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bays         Bay[]
  positions    Position[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Warehouse {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  widthMm        Int
  lengthMm       Int
  // Optimistic concurrency for "save layout".
  layoutVersion  Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objects      WarehouseObject[]
  racks        Rack[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

// Non-storage floor-plan item: wall, door, aisle, loading/packing/work area.
model WarehouseObject {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @db.Uuid
  warehouseId    String              @db.Uuid
  type           WarehouseObjectType
  label          String?
  xMm            Int
  yMm            Int
  widthMm        Int
  depthMm        Int
  rotationDeg    Int                 @default(0)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Cascade)

  @@index([warehouseId])
}

model Rack {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  warehouseId    String   @db.Uuid
  code           String
  name           String?
  xMm            Int
  yMm            Int
  rotationDeg    Int      @default(0)
  lengthMm       Int
  depthMm        Int
  heightMm       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  warehouse Warehouse   @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  levels    RackLevel[]
  bays      Bay[]
  positions Position[]

  @@unique([organizationId, id])
  @@unique([organizationId, warehouseId, id])
  @@unique([warehouseId, code])
}

// A tier. levelIndex is stored 0-based (0 = ground); displayed 1-based (L01).
model RackLevel {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  rackId         String @db.Uuid
  levelIndex     Int
  // Height of the load beam above the floor, and usable vertical space for goods.
  elevationMm    Int
  clearanceMm    Int
  maxLoadG       Int?

  rack      Rack       @relation(fields: [organizationId, rackId], references: [organizationId, id], onDelete: Cascade)
  positions Position[]

  @@unique([rackId, levelIndex])
  @@unique([organizationId, rackId, id])
}

// A section along the rack's length, shared by all levels. bayIndex is 1-based.
// Bay depth = rack depth; bay height = the level's clearance (derived, not stored).
model Bay {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  rackId         String  @db.Uuid
  bayIndex       Int
  offsetMm       Int
  widthMm        Int
  // Storage configuration applied to every level of this bay.
  positionCount  Int     @default(1)
  palletTypeId   String? @db.Uuid

  rack       Rack        @relation(fields: [organizationId, rackId], references: [organizationId, id], onDelete: Cascade)
  palletType PalletType? @relation(fields: [organizationId, palletTypeId], references: [organizationId, id], onDelete: Restrict)
  positions  Position[]

  @@unique([rackId, bayIndex])
  @@unique([organizationId, rackId, id])
}

// The smallest addressable storage location. Structured identifiers are the truth
// (rack -> level -> bay -> positionIndex); `code` is generated from them and stored for lookup.
model Position {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  warehouseId    String  @db.Uuid
  rackId         String  @db.Uuid
  levelId        String  @db.Uuid
  bayId          String  @db.Uuid
  positionIndex  Int
  code           String
  palletTypeId   String? @db.Uuid

  rack       Rack        @relation(fields: [organizationId, warehouseId, rackId], references: [organizationId, warehouseId, id], onDelete: Cascade)
  level      RackLevel   @relation(fields: [organizationId, rackId, levelId], references: [organizationId, rackId, id], onDelete: Cascade)
  bay        Bay         @relation(fields: [organizationId, rackId, bayId], references: [organizationId, rackId, id], onDelete: Cascade)
  palletType PalletType? @relation(fields: [organizationId, palletTypeId], references: [organizationId, id], onDelete: Restrict)

  balances InventoryBalance[]

  @@unique([organizationId, warehouseId, id])
  @@unique([warehouseId, code])
  @@unique([bayId, levelId, positionIndex])
  @@unique([organizationId, id])
  @@index([rackId])
}

// ---------------------------------------------------------------------------
// Catalog and inventory (Phase 3). See docs/inventory.md.
// Quantities are integers. Balances change ONLY through guarded atomic statements in
// modules/inventory/repo; every change writes InventoryMovement rows in the same transaction.
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  RECEIVE
  MOVE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVE
  RELEASE
  // Picking: consumes reserved stock (onHand and reserved both decrease).
  PICK
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  // Every line fully consumed by picking.
  CONSUMED
}

// Product and SKU are the same entity in v1. SKU is unique per organization (stored uppercase).
model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  sku            String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  barcodes         ProductBarcode[]
  balances         InventoryBalance[]
  movements        InventoryMovement[]
  reservationLines ReservationLine[]
  orderLines       OrderLine[]
  pickTasks        PickTask[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

model ProductBarcode {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  barcode        String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  // A barcode resolves to at most one product per organization.
  @@unique([organizationId, barcode])
  @@index([productId])
}

// Current stock of one product at one physical Position. available = onHand - reserved (never stored).
// CHECK constraints (migration SQL): onHand >= 0, reserved >= 0, reserved <= onHand.
model InventoryBalance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  warehouseId    String   @db.Uuid
  positionId     String   @db.Uuid
  productId      String   @db.Uuid
  onHand         Int      @default(0)
  reserved       Int      @default(0)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // Composite FKs: the position must be in this organization AND this warehouse. RESTRICT, so a
  // position that has a balance row can never be silently deleted by a layout change.
  position Position @relation(fields: [organizationId, warehouseId, positionId], references: [organizationId, warehouseId, id], onDelete: Restrict)
  product  Product  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, positionId, productId])
  @@index([organizationId, productId])
  @@index([positionId])
  @@index([organizationId, warehouseId])
}

// One business operation (receive, move, ...). Groups the movement rows it wrote and carries
// the idempotency key. Append-only (trigger in migration SQL).
model InventoryOperation {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @db.Uuid
  type           InventoryMovementType
  idempotencyKey String?
  requestHash    String?
  actorUserId    String?               @db.Uuid
  reason         String?
  refType        String?
  refId          String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]

  // NULL keys never collide, so operations without a key are unconstrained.
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
}

// Immutable audit ledger: one row per balance change. Positions are referenced by plain id plus a
// code snapshot (no FK) so history stays readable after the layout changes.
model InventoryMovement {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                @db.Uuid
  operationId             String                @db.Uuid
  type                    InventoryMovementType
  warehouseId             String                @db.Uuid
  productId               String                @db.Uuid
  positionId              String                @db.Uuid
  positionCode            String
  counterpartPositionId   String?               @db.Uuid
  counterpartPositionCode String?
  qtyDelta                Int
  reservedDelta           Int
  onHandAfter             Int
  reservedAfter           Int
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)

  operation InventoryOperation @relation(fields: [organizationId, operationId], references: [organizationId, id], onDelete: Restrict)
  product   Product            @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
  @@index([organizationId, positionId, createdAt])
  @@index([operationId])
  @@index([organizationId, createdAt])
}

model Reservation {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String            @db.Uuid
  status          ReservationStatus @default(ACTIVE)
  refType         String?
  refId           String?
  note            String?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  releasedAt      DateTime?         @db.Timestamptz(3)
  consumedAt      DateTime?         @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines        ReservationLine[]
  pickTasks    PickTask[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

// A claim on one product at one position. Position is a plain id + code snapshot (history).
model ReservationLine {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String @db.Uuid
  reservationId    String @db.Uuid
  productId        String @db.Uuid
  positionId       String @db.Uuid
  positionCode     String
  quantity         Int
  // Quantity consumed by picking. Outstanding (still reserved) = quantity - consumedQuantity.
  consumedQuantity Int    @default(0)

  reservation Reservation @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Cascade)
  product     Product     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  pickTask    PickTask?

  @@unique([organizationId, id])
  @@unique([reservationId, positionId, productId])
  @@index([organizationId, productId])
}

// ---------------------------------------------------------------------------
// Orders and picking (Phase 4). See docs/picking.md.
// Fulfilment quantities live on OrderLine (requested >= allocated >= picked, CHECKed in the
// migration). Stock itself is NEVER changed here: allocation reserves and picking consumes stock
// through the inventory module (Reservation / InventoryMovement PICK).
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  READY
  PARTIALLY_ALLOCATED
  ALLOCATED
  PICKING
  PICKED
  CANCELLED
}

enum WaveStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PickTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String      @db.Uuid
  // Normalized (uppercase) reference, unique per organization.
  orderNumber     String
  status          OrderStatus @default(DRAFT)
  // Reference in an external system, for later integrations. Not unique.
  externalRef     String?
  note            String?
  createdByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines        OrderLine[]
  tasks        PickTask[]

  @@unique([organizationId, id])
  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model OrderLine {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  orderId        String @db.Uuid
  lineNo         Int
  productId      String @db.Uuid
  requestedQty   Int
  // Quantity reserved for this line and not released. Outstanding reservation = allocatedQty - pickedQty.
  allocatedQty   Int    @default(0)
  pickedQty      Int    @default(0)

  order   Order      @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  product Product    @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  tasks   PickTask[]

  @@unique([orderId, lineNo])
  // One line per product per order keeps allocation and reporting unambiguous.
  @@unique([orderId, productId])
  @@unique([organizationId, id])
  @@index([organizationId, productId])
}

model PickingWave {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String     @db.Uuid
  // Human-readable sequence per organization (displayed as W-0001).
  number          Int
  status          WaveStatus @default(DRAFT)
  note            String?
  createdByUserId String?    @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  releasedAt      DateTime?  @db.Timestamptz(3)
  startedAt       DateTime?  @db.Timestamptz(3)
  completedAt     DateTime?  @db.Timestamptz(3)
  cancelledAt     DateTime?  @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks        PickTask[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status])
}

// Pick `quantity` of one product from one physical position for one order line.
// positionId is the authoritative location (plain id, no FK, like movements and reservation lines,
// so history survives layout changes); positionCode is a readable snapshot.
model PickTask {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @db.Uuid
  waveId            String?        @db.Uuid
  orderId           String         @db.Uuid
  orderLineId       String         @db.Uuid
  productId         String         @db.Uuid
  positionId        String         @db.Uuid
  positionCode      String
  // The reservation (one per task) that backs this task's stock.
  reservationId     String         @db.Uuid
  reservationLineId String         @db.Uuid
  quantity          Int
  pickedQty         Int            @default(0)
  status            PickTaskStatus @default(PENDING)
  completedAt       DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  wave            PickingWave?    @relation(fields: [organizationId, waveId], references: [organizationId, id], onDelete: Restrict)
  order           Order           @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  orderLine       OrderLine       @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)
  product         Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  reservation     Reservation     @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Restrict)
  reservationLine ReservationLine @relation(fields: [organizationId, reservationLineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  // A reservation line backs at most one task.
  @@unique([organizationId, reservationLineId])
  @@index([organizationId, status])
  @@index([organizationId, waveId])
  @@index([orderId])
  @@index([orderLineId])
  @@index([organizationId, productId])
  @@index([positionId])
}
