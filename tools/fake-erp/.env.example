# Fake ERP (development tool). Copy to tools/fake-erp/.env (git-ignored). Placeholders only: NEVER commit real values.
# Everything here can also be set in the fake ERP's Settings page (the saved value wins).

FAKE_ERP_HOST=127.0.0.1
FAKE_ERP_PORT=4100

# Where the WMS runs (the dev server). The webhook URL is {base}/api/webhooks/{public id}.
WMS_WEBHOOK_BASE_URL=http://localhost:3000

# The last part of the integration's inbound path shown in the WMS integration page (/api/webhooks/<this>).
WMS_INTEGRATION_PUBLIC_ID=

# The WMS integration's "Inbound signing secret": the ERP signs what it SENDS to the WMS with it.
WMS_INBOUND_SECRET=

# The WMS integration's "Outbound signing secret": the ERP VERIFIES what the WMS sends with it.
WMS_OUTBOUND_SECRET=

# Length of the "delayed response" mode (ms). The WMS gives up after 10 000 ms.
FAKE_ERP_DELAY_MS=12000
